{
  "name": "stackpanel-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "StackPanel optional plugins, extracted from the kernel repository.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/check-dependencies.mjs --before-install",
    "dev:setup": "node scripts/setup-dev.mjs",
    "deps:check": "node scripts/check-dependencies.mjs",
    "test": "pnpm deps:check && pnpm manifests:check && pnpm manifests:verify && pnpm -r --if-present test",
    "i18n:packages": "node scripts/check-package-catalogs.mjs",
    "i18n:hant": "node scripts/i18n-hant.mjs",
    "i18n:hant:check": "node scripts/i18n-hant.mjs --check",
    "i18n:check": "pnpm i18n:packages && pnpm i18n:hant:check && pnpm i18n:literals",
    "i18n:literals": "node scripts/scan-i18n-literals.mjs --check",
    "feedback:check": "node scripts/check-feedback.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "manifests:check": "node scripts/check-frontend-manifests.mjs",
    "manifests:verify": "node scripts/verify-frontend-manifests.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "opencc-js": "^1.4.2",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
