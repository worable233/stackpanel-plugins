        {
          "fetch": {
            "path": "/llm-gateway/admin/accounts"
          },
          "as": "accounts"
        },
        {
          "fetch": {
            "path": "/llm-gateway/admin/prices"
          },
          "as": "prices"
        }
      ]
    },
    {
      "path": "/prices/:id/edit",
      "component": "admin/price-editor",
      "permission": "llm-gateway.admin",
      "data": [
        {
          "fetch": {
            "path": "/llm-gateway/admin/accounts"
          },
          "as": "accounts"
        },
        {
          "fetch": {
            "path": "/llm-gateway/admin/prices"
          },
          "as": "prices"
        }
      ]
    },
    {
      "path": "/accounts",
      "component": "admin/accounts",
      "permission": "llm-gateway.admin",
      "nav": {
        "labelKey": "nav.adminAccounts",
        "groupKey": "nav.group",
        "order": 10,
        "activePaths": [
          "/prices"
