        "labelKey": "nav.overview",
        "groupKey": "nav.group",
        "order": 0
      },
      "data": [
        {
          "fetch": {
            "path": "/llm-gateway/admin/overview"
          },
          "as": "overview"
        }
      ]
    },
    {
      "path": "/accounts/new",
      "component": "admin/account-editor",
      "permission": "llm-gateway.admin",
      "data": [
        {
          "fetch": {
            "path": "/llm-gateway/admin/accounts"
          },
          "as": "accounts"
        }
      ]
    },
    {
      "path": "/accounts/:id/edit",
      "component": "admin/account-editor",
      "permission": "llm-gateway.admin",
      "data": [
        {
          "fetch": {
            "path": "/llm-gateway/admin/accounts"
          },
          "as": "accounts"
        }
      ]
    },
    {
      "path": "/prices/new",
      "component": "admin/price-editor",
      "permission": "llm-gateway.admin",
