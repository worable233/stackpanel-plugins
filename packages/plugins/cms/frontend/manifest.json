{
  "version": "0.1.0",
  "revision": "8c37c7e5db9f",
  "entry": "frontend/dist/index.js",
  "pages": [
    {
      "path": "/blog/:slug",
      "component": "article",
      "data": [
        {
          "finder": "cms.publicPost",
          "as": "article",
          "input": {
            "slug": ":slug"
          }
        }
      ]
    }
  ],
  "layouts": [],
  "finders": [
    "cms.publicPost",
    "cms.adminPosts",
    "cms.adminPages",
    "cms.adminRedirects"
  ],
  "adminRoutes": [
    {
      "path": "/overview",
      "component": "admin/summary",
      "nav": {
        "labelKey": "nav.overview",
        "groupKey": "nav.group",
        "order": 0
      },
      "data": [
        {
          "finder": "cms.adminPosts",
          "as": "posts"
        },
        {
          "finder": "cms.adminPages",
          "as": "pages"
        },
        {
          "finder": "cms.adminRedirects",
          "as": "redirects"
        }
      ]
    },
    {
      "path": "/posts",
      "component": "admin/posts",
      "data": [
        {
          "finder": "cms.adminPosts",
          "as": "list"
        }
      ],
      "nav": {
        "labelKey": "nav.posts",
        "groupKey": "nav.group",
        "order": 10
      }
    },
    {
      "path": "/pages",
      "component": "admin/pages",
      "data": [
        {
          "finder": "cms.adminPages",
          "as": "list"
        }
      ],
      "nav": {
        "labelKey": "nav.pages",
        "groupKey": "nav.group",
        "order": 20
      }
    },
    {
      "path": "/redirects",
      "component": "admin/redirects",
      "data": [
        {
          "finder": "cms.adminRedirects",
          "as": "list"
        }
      ],
      "nav": {
        "labelKey": "nav.redirects",
        "groupKey": "nav.group",
        "order": 30
      }
    },
    {
      "path": "/posts/new",
      "component": "admin/post-new"
    },
    {
      "path": "/pages/new",
      "component": "admin/page-new"
    },
    {
      "path": "/posts/:id",
      "component": "admin/post-edit"
    },
    {
      "path": "/pages/:id",
      "component": "admin/page-edit"
    }
  ],
  "adminActions": [],
  "actions": [],
  "accountRoutes": [],
  "accountWidgets": [],
