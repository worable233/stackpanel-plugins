{
  "version": "0.1.0",
  "revision": "c071fa6e45c9",
  "entry": "frontend/dist/index.js",
  "pages": [
    {
      "path": "/blog/:slug",
      "component": "article",
      "data": [
        {
          "finder": "cms.publicPost",
          "as": "article",
          "input": {
            "slug": ":slug"
          }
        }
      ]
    }
  ],
  "layouts": [],
  "finders": [
    "cms.publicPost",
    "cms.adminPosts",
    "cms.adminPages",
    "cms.adminRedirects"
  ],
  "adminRoutes": [
    {
      "path": "/overview",
      "component": "admin/summary",
      "nav": {
        "label": "概览",
        "group": "内容",
        "order": 0
      },
      "data": [
        {
          "finder": "cms.adminPosts",
          "as": "posts"
        },
        {
          "finder": "cms.adminPages",
          "as": "pages"
        },
        {
          "finder": "cms.adminRedirects",
          "as": "redirects"
        }
      ]
    },
    {
      "path": "/posts",
      "component": "admin/posts",
      "data": [
        {
          "finder": "cms.adminPosts",
          "as": "list"
        }
      ],
      "nav": {
        "label": "文章",
        "group": "内容",
        "order": 10
      }
    },
    {
      "path": "/pages",
      "component": "admin/pages",
      "data": [
        {
          "finder": "cms.adminPages",
          "as": "list"
        }
      ],
      "nav": {
        "label": "页面",
        "group": "内容",
        "order": 20
      }
    },
    {
      "path": "/redirects",
      "component": "admin/redirects",
      "data": [
        {
          "finder": "cms.adminRedirects",
          "as": "list"
        }
      ],
      "nav": {
        "label": "重定向",
        "group": "内容",
        "order": 30
      }
    },
    {
      "path": "/posts/new",
      "component": "admin/post-new"
    },
    {
      "path": "/pages/new",
      "component": "admin/page-new"
    },
    {
      "path": "/posts/:id",
      "component": "admin/post-edit"
    },
    {
      "path": "/pages/:id",
      "component": "admin/page-edit"
    }
  ],
  "adminActions": [],
  "actions": [],
  "accountRoutes": [],
  "accountWidgets": [],
  "files": [
    "frontend/dist/admin.js",
    "frontend/dist/admin.js.map",
    "frontend/dist/admin.runtime.js",
    "frontend/dist/admin.runtime.js.map",
    "frontend/dist/index.js",
    "frontend/dist/index.js.map"
  ]
}
