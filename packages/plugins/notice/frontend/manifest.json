{
  "version": "0.1.0",
  "entry": "frontend/dist/index.js",
  "pages": [
    {
      "path": "/notice",
      "component": "notice/index",
      "data": [
        {
          "fetch": {
            "path": "/notices"
          },
          "as": "announcements"
        }
      ]
    }
  ],
  "layouts": [],
  "finders": [],
  "adminRoutes": [
    {
      "path": "/overview",
      "component": "admin/overview",
      "permission": "notice.admin",
      "nav": {
        "labelKey": "nav.label",
        "groupKey": "nav.group",
        "order": 40
      },
      "data": [
        {
          "fetch": {
            "path": "/notice/admin/announcements"
          },
          "as": "announcements"
        }
      ]
    }
  ],
  "adminActions": [],
  "actions": [
    {
      "id": "notice.create",
      "method": "POST",
      "path": "/notice/admin/announcements",
      "permission": "notice.admin",
      "successFeedback": {
        "messageKey": "feedback.created"
      },
      "input": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "content",
          "type": "string",
          "required": true,
          "maxLength": 5000
        },
        {
          "name": "sortOrder",
          "type": "integer",
          "default": 0,
          "min": 0,
          "max": 9999
        },
        {
          "name": "published",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "notice.toggle",
      "method": "PATCH",
      "path": "/notice/admin/announcements/:id",
      "permission": "notice.admin",
      "silent": true,
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "published",
          "type": "boolean",
          "required": true
        }
      ]
    },
    {
      "id": "notice.delete",
      "method": "DELETE",
      "path": "/notice/admin/announcements/:id",
      "permission": "notice.admin",
      "successFeedback": {
        "messageKey": "feedback.deleted"
      },
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        }
      ]
    }
  ],
  "accountRoutes": [],
  "accountWidgets": [],
  "files": [
    "frontend/dist/admin.js",
    "frontend/dist/admin.js.map",
    "frontend/dist/admin.runtime.js",
    "frontend/dist/admin.runtime.js.map",
    "frontend/dist/index.js",
    "frontend/dist/index.js.map"
  ],
  "locales": ["zh-CN", "zh-TW", "zh-HK", "en-US"],
