        {
          "name": "protocol",
          "type": "string",
          "required": true,
          "maxLength": 8
        },
        {
          "name": "username",
          "type": "string",
          "maxLength": 191
        },
        {
          "name": "password",
          "type": "string",
          "maxLength": 191
        },
        {
          "name": "currency",
          "type": "string",
          "required": true,
          "maxLength": 8
        },
        {
          "name": "markupBps",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 100000
