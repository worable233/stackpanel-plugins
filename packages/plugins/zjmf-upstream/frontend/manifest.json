      "permission": "zjmf-upstream.admin",
      "input": [
        {
          "name": "name",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "baseUrl",
          "type": "string",
          "required": true,
          "maxLength": 191
