        {
          "name": "password",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "currency",
          "type": "string",
          "required": true,
          "maxLength": 8
        },
        {
          "name": "markupBps",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 100000
