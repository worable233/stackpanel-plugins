{
  "name": "@stackpanel/plugin-wecom-mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "stackpanel": {
    "builtin": false
  },
  "description": "企业微信邮箱发件渠道：用企业微信「应用发送邮件」接口投递站内通知与注册验证码，不需要自建 SMTP 与发信域名。",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "node ../../../scripts/build-plugin.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@stackpanel/sdk": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
