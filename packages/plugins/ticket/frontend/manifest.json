  "adminRoutes": [
    {
      "path": "/overview",
      "component": "admin/summary",
      "permission": "ticket.admin",
      "nav": {
        "labelKey": "nav.overview",
        "groupKey": "nav.group",
        "order": 0
      },
      "data": [
        {
          "finder": "ticket.adminSummary",
          "as": "summary"
        }
      ]
    },
    {
      "path": "/tickets",
      "component": "admin/tickets",
      "permission": "ticket.admin",
      "nav": {
        "labelKey": "nav.adminTickets",
        "groupKey": "nav.group",
        "order": 10
      },
      "data": [
        {
          "finder": "ticket.adminTickets",
          "as": "tickets"
        }
      ]
    },
    {
      "path": "/tickets/:id",
      "component": "admin/tickets/detail",
      "permission": "ticket.admin",
      "data": [
        {
          "finder": "ticket.adminTicket",
          "as": "ticket",
          "input": {
            "id": ":id"
          }
        }
      ]
    }
  ],
  "adminActions": [],
  "actions": [
    {
      "id": "ticket.create",
      "method": "POST",
      "path": "/tickets",
      "permission": "ticket.create",
      "redirect": {
        "responsePath": "redirectUrl"
      },
      "input": [
        {
          "name": "subject",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "body",
          "type": "string",
          "required": true,
          "maxLength": 10000
        },
        {
          "name": "category",
          "type": "string",
          "maxLength": 64
        },
        {
          "name": "relatedType",
          "type": "string",
          "maxLength": 16
        },
        {
          "name": "relatedId",
          "type": "string",
          "maxLength": 191
        }
      ]
    },
    {
      "id": "ticket.reply",
      "method": "POST",
      "path": "/tickets/:id/messages",
      "permission": "ticket.create",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "body",
          "type": "string",
          "required": true,
          "maxLength": 10000
        },
        {
          "name": "internal",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "ticket.close",
      "method": "POST",
      "path": "/tickets/:id/close",
      "permission": "ticket.create",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "reason",
          "type": "string",
          "maxLength": 10000
        }
      ]
    },
    {
      "id": "ticket.remind",
      "method": "POST",
      "path": "/tickets/:id/remind",
      "permission": "ticket.create",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        }
      ]
    },
    {
      "id": "ticket.update",
      "method": "PATCH",
      "path": "/ticket/admin/tickets/:id",
      "permission": "ticket.admin",
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "status",
          "type": "string",
          "maxLength": 32
        },
        {
          "name": "priority",
          "type": "string",
          "maxLength": 32
        },
        {
          "name": "assigneeId",
          "type": "string",
          "maxLength": 191
        },
        {
          "name": "category",
          "type": "string",
          "maxLength": 64
        },
        {
          "name": "departmentId",
          "type": "string",
          "maxLength": 191
        }
      ]
    }
  ],
  "accountRoutes": [
    {
      "path": "/support",
      "component": "account/support-overview",
      "permission": "ticket.view",
      "nav": {
        "labelKey": "nav.overview",
