    {
      "path": "/tickets/new",
      "component": "account/tickets/new",
      "permission": "ticket.create",
      "data": [
        {
          "finder": "ticket.myTickets",
          "as": "tickets"
        }
      ]
    },
    {
      "path": "/tickets/:id",
      "component": "account/tickets/detail",
      "permission": "ticket.view",
      "data": [
        {
          "finder": "ticket.myTickets",
          "as": "tickets"
        },
        {
          "finder": "ticket.ticket",
          "as": "ticket",
          "input": {
            "id": ":id"
          }
        }
      ]
    }
  ],
