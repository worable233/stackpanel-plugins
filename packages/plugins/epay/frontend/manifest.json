  "adminActions": [],
  "actions": [
    {
      "id": "epay.configure",
      "method": "POST",
      "path": "/epay/admin/config",
      "permission": "epay.admin",
      "silent": true,
      "input": [
        {
          "name": "baseUrl",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "pid",
          "type": "string",
          "required": true,
          "maxLength": 64
        },
        {
          "name": "privateKey",
          "type": "string",
          "required": true,
          "maxLength": 20000
        },
        {
          "name": "platformPublicKey",
          "type": "string",
          "required": true,
          "maxLength": 20000
        },
        {
          "name": "methods",
          "type": "string",
          "required": true,
          "maxLength": 64
        }
      ]
    }
  ],
