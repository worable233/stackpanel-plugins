  ],
  "adminRoutes": [
    {
      "path": "/invoices",
      "component": "admin/invoices",
      "permission": "invoice.admin",
      "nav": {
        "labelKey": "nav.label",
        "groupKey": "nav.group",
        "order": 20
      },
      "data": [
        {
          "finder": "invoice.adminInvoices",
          "as": "invoices",
          "input": {
            "$query": "1"
          }
        }
      ]
    },
    {
      "path": "/invoices/new",
      "component": "admin/invoice-new",
      "permission": "invoice.admin",
      "data": [
        {
          "finder": "invoice.orders",
          "as": "orders"
        },
        {
          "finder": "invoice.platform",
          "as": "platform"
        }
      ]
    },
    {
      "path": "/invoices/:id",
      "component": "admin/invoice-editor",
      "permission": "invoice.admin",
      "data": [
        {
          "finder": "invoice.adminInvoice",
          "as": "invoice",
          "input": {
            "id": ":id"
          }
        },
        {
          "finder": "invoice.orders",
          "as": "orders"
        },
        {
          "finder": "invoice.platform",
          "as": "platform"
        }
      ]
    }
  ],
  "adminActions": [],
