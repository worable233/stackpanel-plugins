{
  "version": "0.1.0",
  "entry": "frontend/dist/index.js",
  "pages": [],
  "layouts": [],
  "finders": [],
  "adminRoutes": [
    {
      "path": "/referrals",
      "component": "admin/referrals",
      "permission": "store.admin",
      "systemSettings": {
        "labelKey": "admin.systemSettings",
        "order": 120
      },
      "data": [
        {
          "fetch": {
            "path": "/store/admin/referrals"
          },
          "as": "referral"
        },
        {
          "fetch": {
            "path": "/store/admin/referrals/config"
          },
          "as": "referralConfig"
        }
      ]
    }
  ],
  "adminActions": [],
  "actions": [
    {
      "id": "referral.create-code",
      "method": "POST",
      "path": "/referral/codes",
      "permission": "store.referral",
      "successFeedback": {
        "messageKey": "feedback.codeCreated"
      },
      "input": [
        {
          "name": "label",
          "type": "string",
          "maxLength": 40
        },
        {
          "name": "rewardAmount",
          "type": "integer",
          "min": 0,
          "max": 2000000000
        }
      ]
    },
    {
      "id": "referral.toggle-code",
      "method": "PATCH",
      "path": "/referral/codes/:id",
      "permission": "store.referral",
      "silent": true,
      "input": [
        {
          "name": "id",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "state",
          "type": "string",
          "required": true,
          "maxLength": 16
        }
      ]
    },
    {
      "id": "referral.save-config",
      "method": "POST",
      "path": "/store/admin/referrals/config",
      "permission": "store.admin",
      "successFeedback": {
        "messageKey": "feedback.configSaved"
      },
      "input": [
        {
          "name": "enabled",
          "type": "boolean",
          "required": true
        },
        {
          "name": "trigger",
          "type": "string",
          "required": true,
          "maxLength": 32
        },
        {
          "name": "rewardAmount",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 2000000000
        },
        {
          "name": "inviteeRewardAmount",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 2000000000
        },
        {
          "name": "freezeDays",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 365
        },
        {
          "name": "cookieDays",
          "type": "integer",
          "required": true,
          "min": 1,
          "max": 365
        },
        {
          "name": "maxInvitesPerUser",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 100000
        },
        {
          "name": "sameIpLimit",
          "type": "integer",
          "required": true,
          "min": 0,
          "max": 1000
        },
        {
          "name": "currency",
          "type": "string",
          "required": true,
          "maxLength": 8
        }
      ]
    },
    {
      "id": "referral.adjust",
      "method": "POST",
      "path": "/store/admin/referrals/adjustments",
      "permission": "store.admin",
      "successFeedback": {
        "messageKey": "feedback.adjusted"
      },
      "input": [
        {
          "name": "email",
          "type": "string",
          "required": true,
          "maxLength": 191
        },
        {
          "name": "amount",
          "type": "integer",
          "required": true,
          "min": -2000000000,
          "max": 2000000000
        },
        {
          "name": "note",
          "type": "string",
          "required": true,
          "maxLength": 191
        }
      ]
    }
  ],
  "accountRoutes": [
    {
      "path": "/referral",
      "component": "account/referral",
      "permission": "store.referral",
      "nav": {
        "labelKey": "nav.label",
        "groupKey": "nav.group",
        "order": 20
      },
      "data": [
        {
          "fetch": {
            "path": "/referral/me"
          },
          "as": "referral"
        }
      ]
    }
  ],
  "accountWidgets": [],
